# Runtime files live in /mnt/appdata/containers/unifi-emulator, not inside repo/.
# Full immutable source SHA, also used as the locally built image tag.
MTUNIFI_RELEASE=
# A DIFFERENT production controller: new identities/adoption; no test keys/state.
# Actual device inform endpoint, usually http://<controller IPv4 or DNS>:8080/inform.
MTUNIFI_INFORM_URL=
# Existing suitable Docker network on RUBIK; do not assume the lab network exists.
MTUNIFI_DOCKER_NETWORK=
# Three reserved, unused IPv4 addresses inside that network's IPAM subnet.
# Each value is used for both container networking and advertised device IP.
MTUNIFI_US8_IP=
MTUNIFI_GATEWAY_IP=
MTUNIFI_CRS326_IP=
# Non-secret usernames. Passwords are file secrets; never put them here.
MTUNIFI_ROUTEROS_USER=
MTUNIFI_CRS326_USER=
# RB760iGS 192.168.0.249:8728; CRS326 192.168.0.251:8728, explicit plaintext API.
# The two RB views share the RB secret, with separate sessions and identities.
MTUNIFI_ROUTEROS_WAN_INTERFACE=ether1
