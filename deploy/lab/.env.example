# python3 init-env.py creates .env with two independent random hex passwords.
# When configuring manually, fill both passwords before starting Compose.
MONGO_ROOT_PASSWORD=
MONGO_PASS=
PUID=1000
PGID=1000
TZ=Europe/Prague
UNIFI_IMAGE=lscr.io/linuxserver/unifi-network-application:latest
UNIFI_BIND_IP=127.0.0.1
UNIFI_HTTPS_PORT=8443
UNIFI_LAB_NETWORK=unifi-lab
UNIFI_LAB_SUBNET=172.30.88.0/24
UNIFI_SIMULATOR_IP=172.30.88.10
MTUNIFI_HOSTNAME=mtunifi-lab
MTUNIFI_ENCRYPTION=cbc
MTUNIFI_PACKET_VERSION=1
MTUNIFI_TRACE=false
# File below examples/, mounted read-only as /scenarios inside the emulator.
MTUNIFI_SCENARIO=synthetic-switch.json
# Optional M2 override: compose.simulator.yml + compose.routeros.yml.
# Username only; password comes from ../../.secrets/routeros-password, never .env.
# MTUNIFI_ROUTEROS_USER=unifi-reader
# MTUNIFI_ROUTEROS_HOST=192.168.0.249
# MTUNIFI_ROUTEROS_PORT=8728
# MTUNIFI_ROUTEROS_TLS=false
# MTUNIFI_ROUTEROS_MAP=routeros-rb760igs.json
# Optional M5: also merge compose.multidevice.yml for the independent CRS326.
# Separate secret: ../../.secrets/routeros-crs326-password (not an .env password).
# MTUNIFI_CRS326_USER=unifi-reader
# MTUNIFI_CRS326_HOST=192.168.0.251
# MTUNIFI_CRS326_PORT=8728
# MTUNIFI_CRS326_TLS=false
# MTUNIFI_CRS326_MAP=routeros-crs326.json
