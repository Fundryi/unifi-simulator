# Use only an isolated controller you administer. No real UniFi identity or adoption key needed.
# With compose.lab.yml use http://controller:8080/inform instead.
MTUNIFI_INFORM_URL=http://192.0.2.20:8080/inform
# Address reachable by the controller; 192.0.2.10 is a documentation placeholder.
MTUNIFI_DEVICE_IP=192.0.2.10
MTUNIFI_HOSTNAME=mtunifi-lab
MTUNIFI_ENCRYPTION=cbc
MTUNIFI_PACKET_VERSION=1
MTUNIFI_TRACE=false
MTUNIFI_SYNTHETIC_FILE=/scenarios/synthetic-switch.json
# RouterOS mode uses the lab override; see docs/routeros.md.
# Optional: firmware the controller offers for the profile model, so no update is shown.
# MTUNIFI_FIRMWARE_VERSION=7.5.15.17146
